{
  "name": "groundloop",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-groundloop-rules --config firebase.test.json \"jest --config jest.rules.config.js --ci\"",
    "lint": "expo lint",
    "deploy:backend": "firebase deploy --only firestore,storage,functions"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "expo": "~52.0.11",
    "expo-apple-authentication": "~7.1.2",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.1",
    "expo-dev-client": "~5.0.4",
    "expo-image-picker": "~16.0.3",
    "expo-linking": "~7.0.3",
    "expo-location": "~18.0.2",
    "expo-router": "~4.0.9",
    "expo-sharing": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "firebase": "^11.0.2",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-maps": "1.18.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-svg": "15.8.0",
    "react-native-view-shot": "~4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "firebase-tools": "^13.35.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/__tests__/rules/"
    ]
  }
}
